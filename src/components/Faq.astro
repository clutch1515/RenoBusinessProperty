---
interface Item { q: string; a: string }   // a may contain simple HTML links
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p set:html={i.a} />
    </details>
  ))}
</div>
<style>
  .faq { margin-top: 2rem; border-top: 2px solid var(--ink); max-width: 48rem; }
  details { border-bottom: 1px solid var(--rule); }
  summary { cursor: pointer; list-style: none; padding: 1.2rem 2.5rem 1.1rem 0; position: relative; font-family: var(--sans); font-weight: 700; font-size: var(--t-md); line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0.25rem; top: 1.05rem; font-size: 1.6rem; font-weight: 400; color: var(--green); line-height: 1; }
  details[open] summary::after { content: '\2212'; }
  p { margin: 0 0 1.4rem; color: var(--ink-soft); max-width: var(--measure); }
</style>
