  <path class="ridge" d="M0,196 L110,166 L220,184 L330,156 L450,182 L560,160 L680,186 L790,164 L900,186 L1010,164 L1120,180 L1200,170 L1200,250 L0,250 Z" />
  <rect class="ground" y="238" width="1200" height="62" />
  <g class="fill-ink" opacity="0.85">
    <rect x="470" y="200" width="20" height="38" /><rect x="494" y="176" width="18" height="62" /><rect x="516" y="150" width="24" height="88" />
    <rect x="544" y="186" width="18" height="52" /><rect x="566" y="164" width="22" height="74" /><rect x="592" y="196" width="26" height="42" />
    <rect x="622" y="180" width="16" height="58" /><rect x="642" y="206" width="30" height="32" /><rect x="676" y="194" width="18" height="44" />
