---
const { label = 'Illustration of a historic two-story downtown commercial building beside the Truckee River.' } = Astro.props;
---
<svg class="art" viewBox="0 0 600 480" role="img" aria-label={label} preserveAspectRatio="xMidYMax slice">
  <rect class="bg" width="600" height="480" />
  <path class="ridge-far" d="M0,268 L48,236 L96,252 L150,206 L206,238 L262,196 L318,228 L372,204 L430,240 L488,212 L548,236 L600,222 L600,400 L0,400 Z" />
  <rect class="ground" y="400" width="600" height="80" />
  <!-- neighbors -->
  <rect class="bld-alt" x="10" y="270" width="110" height="130" />
  <rect class="glass" x="26" y="300" width="34" height="40" /><rect class="glass" x="72" y="300" width="34" height="40" />
  <rect class="bld-alt" x="480" y="190" width="110" height="210" />
  <g><rect class="glass" x="496" y="210" width="30" height="36" /><rect class="glass" x="544" y="210" width="30" height="36" /><rect class="glass" x="496" y="262" width="30" height="36" /><rect class="glass" x="544" y="262" width="30" height="36" /><rect class="glass" x="496" y="314" width="30" height="36" /><rect class="glass" x="544" y="314" width="30" height="36" /></g>
  <!-- main building -->
  <rect class="bld" x="120" y="176" width="360" height="224" />
  <rect class="bld" x="112" y="164" width="376" height="18" />
  <g class="fill-ink"><rect x="126" y="184" width="10" height="6" /><rect x="150" y="184" width="10" height="6" /><rect x="174" y="184" width="10" height="6" /><rect x="198" y="184" width="10" height="6" /><rect x="222" y="184" width="10" height="6" /><rect x="246" y="184" width="10" height="6" /><rect x="270" y="184" width="10" height="6" /><rect x="294" y="184" width="10" height="6" /><rect x="318" y="184" width="10" height="6" /><rect x="342" y="184" width="10" height="6" /><rect x="366" y="184" width="10" height="6" /><rect x="390" y="184" width="10" height="6" /><rect x="414" y="184" width="10" height="6" /><rect x="438" y="184" width="10" height="6" /><rect x="462" y="184" width="10" height="6" /></g>
  <!-- arched upper windows -->
  <g>
    <path class="glass" d="M146,280 L146,224 A20,20 0 0 1 186,224 L186,280 Z" />
    <path class="glass" d="M214,280 L214,224 A20,20 0 0 1 254,224 L254,280 Z" />
    <path class="glass" d="M282,280 L282,224 A20,20 0 0 1 322,224 L322,280 Z" />
    <path class="glass" d="M350,280 L350,224 A20,20 0 0 1 390,224 L390,280 Z" />
    <path class="glass" d="M418,280 L418,224 A20,20 0 0 1 458,224 L458,280 Z" />
  </g>
  <line class="ink" x1="120" y1="296" x2="480" y2="296" />
  <!-- storefront -->
  <rect class="glass" x="136" y="312" width="130" height="88" />
  <rect class="glass" x="334" y="312" width="130" height="88" />
  <line class="thin" x1="201" y1="312" x2="201" y2="400" /><line class="thin" x1="399" y1="312" x2="399" y2="400" />
  <rect class="fill-green" x="276" y="318" width="48" height="82" />
  <line style="stroke:#fff;stroke-width:2" x1="300" y1="326" x2="300" y2="394" />
  <rect class="fill-green" x="270" y="304" width="60" height="8" />
  <!-- riverwalk and river -->
  <line class="ink" x1="0" y1="418" x2="600" y2="418" />
  <g class="thin"><line x1="20" y1="404" x2="20" y2="418" /><line x1="80" y1="404" x2="80" y2="418" /><line x1="140" y1="404" x2="140" y2="418" /><line x1="200" y1="404" x2="200" y2="418" /><line x1="260" y1="404" x2="260" y2="418" /><line x1="320" y1="404" x2="320" y2="418" /><line x1="380" y1="404" x2="380" y2="418" /><line x1="440" y1="404" x2="440" y2="418" /><line x1="500" y1="404" x2="500" y2="418" /><line x1="560" y1="404" x2="560" y2="418" /><line x1="0" y1="404" x2="600" y2="404" /></g>
  <path class="river" d="M0,438 C120,428 220,446 320,436 S500,428 600,438 L600,480 L0,480 Z" />
</svg>
