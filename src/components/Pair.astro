---
// Two side-by-side columns, each with a heading, text or list, and an optional link.
interface Col { h: string; text?: string; list?: string[]; href?: string; cta?: string }
interface Props { cols: Col[] }
const { cols } = Astro.props;
---
<div class="pair">
  {cols.map((c) => (
    <div class="col">
      <h3>{c.h}</h3>
      {c.text && <p>{c.text}</p>}
      {c.list && <ul>{c.list.map((li) => <li>{li}</li>)}</ul>}
      {c.href && <a href={c.href}>{c.cta}</a>}
    </div>
  ))}
</div>
<style>
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 2rem; border-top: 2px solid var(--ink); }
  .col { padding: 1.5rem 2.5rem 0.5rem 0; }
  .col + .col { padding-left: 2.5rem; border-left: 1px solid var(--rule); }
  h3 { font-size: var(--t-lg); }
  p { color: var(--ink-soft); }
  ul { margin: 0 0 1em; padding-left: 1.2em; color: var(--ink-soft); }
  li { margin-bottom: 0.3em; }
  li::marker { color: var(--sage); }
  a { font-family: var(--sans); font-weight: 700; }
  @media (max-width: 48rem) {
    .pair { grid-template-columns: 1fr; }
    .col + .col { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>
