---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.seoTitle ?? `${frontmatter.title} | Reno Business Property`} description={frontmatter.description}>
  <article class="wrap" style="padding-block: clamp(2.5rem, 6vw, 4rem);">
    <h1>{frontmatter.title}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>
